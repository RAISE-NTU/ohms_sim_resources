        <visual name='visual'>
          <geometry><plane><normal>0 1 0</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.45 0.7 0.95 1</ambient>
            <diffuse>0.45 0.7 0.95 1</diffuse>
            <emissive>0.45 0.7 0.95 1</emissive>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
        <pose>0 -250 0 0 0 0</pose>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

